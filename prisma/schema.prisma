// Schema do banco de dados do Kyrius (Prisma + PostgreSQL).
// Fase 1 multi-tenant: organizacoes, usuarios, e escopo de conversas/logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Uma empresa/cliente do Kyrius (tenant).
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
}

/// Um usuario, pertencente a uma organizacao. Identificado pelo WhatsApp.
model User {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String?
  whatsappPhone  String   @unique
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

/// Credenciais de uma integracao conectada por uma organizacao (multi-tenant).
/// DEV: credentials em texto. PRODUCAO: criptografar (ex: Secrets Manager).
model Connection {
  id             String   @id @default(uuid())
  organizationId String
  provider       String // 'hubspot' | 'stripe' | 'mercadopago' | 'asaas' | 'google'
  credentials    Json // ex: { "token": "..." }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, provider])
}

/// Preferencia de resumo diario proativo de uma organizacao.
///
/// O Kyrius envia o resumo sozinho no horario configurado, sem o dono
/// precisar perguntar — e o que transforma o produto de "ferramenta que
/// respondo quando lembro" em "assistente que trabalha".
model ReportSchedule {
  id             String    @id @default(uuid())
  organizationId String    @unique
  enabled        Boolean   @default(true)
  /// Horario local (America/Sao_Paulo) em que o resumo deve sair.
  hour           Int       @default(8)
  minute         Int       @default(0)
  /// Instrucao opcional do dono sobre o que destacar no resumo.
  focus          String?
  /// Ultimo envio bem-sucedido — garante um envio por dia mesmo com restart.
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Uma mensagem trocada com um contato (historico de conversa persistente).
model Message {
  id             String   @id @default(uuid())
  contact        String // numero de WhatsApp do contato
  role           String // 'user' | 'assistant'
  content        String
  organizationId String? // escopo multi-tenant
  userId         String?
  createdAt      DateTime @default(now())

  @@index([contact, createdAt])
  @@index([organizationId, createdAt])
}

/// Registro de cada execucao de ferramenta pela IA (auditoria/logs).
model OperationLog {
  id             String   @id @default(uuid())
  contact        String // contato que originou a operacao (se houver)
  tool           String // nome da ferramenta executada
  input          Json // argumentos recebidos
  result         String // resultado (texto devolvido a IA)
  success        Boolean  @default(true)
  organizationId String? // escopo multi-tenant
  userId         String?
  createdAt      DateTime @default(now())

  @@index([contact, createdAt])
  @@index([tool, createdAt])
  @@index([organizationId, createdAt])
}
