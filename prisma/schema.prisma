// Schema do banco de dados do Katalli (Prisma + PostgreSQL).
// Fase 1 multi-tenant: organizacoes, usuarios, e escopo de conversas/logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Uma empresa/cliente do Katalli (tenant).
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  /// Instrucoes que o dono escreve para o atendimento AO PUBLICO (ex: Direct
  /// do Instagram): horario, endereco, servicos, precos, o que responder e o
  /// que nao responder. Vazio = o atendimento publico fica desligado.
  ///
  /// Fica aqui, e nao no system prompt, porque e conteudo de cada cliente —
  /// muda por organizacao e o proprio dono edita pela conversa.
  atendimentoInstrucoes String?

  /// Organizacao de DEMONSTRACAO: as ferramentas devolvem dados ficticios em
  /// vez de chamar as APIs reais.
  ///
  /// Serve para apresentar o produto sem expor dados de ninguem. O fluxo
  /// continua sendo o real — a IA escolhe a ferramenta, a execucao e auditada,
  /// escrita pede confirmacao — so a resposta da integracao e inventada.
  demo Boolean @default(false)

  /// Criada pelo proprio visitante em /criar-conta, sem convite.
  ///
  /// Registrado para voce conseguir separar, no painel e no banco, quem entrou
  /// por indicacao sua de quem apareceu sozinho — sao funis diferentes e
  /// merecem tratamento comercial diferente.
  autocadastro Boolean @default(false)

  /// Teto TOTAL de mensagens que esta organizacao pode enviar no chat.
  ///
  /// Mecanismo de TRIAL, nao de plano: nao reseta. `null` = sem teto (todo
  /// cliente que voce cadastra por convite). Contas de autocadastro nascem com
  /// o limite de KATALLI_AUTOCADASTRO_LIMITE, porque a rota e publica.
  ///
  /// Diferente de `plano`/`limiteTokensDia`, que e a cota recorrente do
  /// cliente pagante — as duas convivem: o trial acaba de vez, a cota renova.
  limiteInteracoes Int?

  /// Plano comercial contratado. Define a cota diaria de tokens.
  ///
  /// O limite de cada plano mora em CODIGO (src/ai/planos.ts), nao aqui: mudar
  /// a cota de um plano deve valer para todos os clientes dele de uma vez, e
  /// numa coluna isso exigiria varrer o banco a cada reajuste. Aqui fica so a
  /// qual plano a empresa pertence.
  plano String @default("padrao")

  /// Cota diaria de tokens especifica desta organizacao.
  ///
  /// `null` = usa a cota do plano. Existe para o caso concreto de negociar
  /// condicao diferente com um cliente sem precisar inventar um plano novo.
  limiteTokensDia Int?

  users User[]
}

/// Um usuario, pertencente a uma organizacao. Identificado pelo WhatsApp.
model User {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String?
  /// Numero de WhatsApp. Opcional: quem entra so pelo Chat Web nao tem um.
  whatsappPhone  String?  @unique
  /// Login do Chat Web. Opcional: quem so usa WhatsApp nao tem e-mail cadastrado.
  email          String?  @unique
  /// Hash da senha do Chat Web (scrypt). Nunca guardar a senha em claro.
  passwordHash   String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

/// Credenciais de uma integracao conectada por uma organizacao (multi-tenant).
/// DEV: credentials em texto. PRODUCAO: criptografar (ex: Secrets Manager).
model Connection {
  id             String   @id @default(uuid())
  organizationId String
  provider       String // 'hubspot' | 'stripe' | 'mercadopago' | 'asaas' | 'google'
  credentials    Json // ex: { "token": "..." }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, provider])
}

/// Convite de acesso ao Chat Web.
///
/// O cliente define a PROPRIA senha ao aceitar — assim ninguem precisa
/// manusear a credencial de outra pessoa. O token vai no link; no banco fica
/// apenas o hash, entao vazar a tabela nao entrega nenhum convite valido.
model Invite {
  id             String    @id @default(uuid())
  /// SHA-256 do token enviado no link.
  tokenHash      String    @unique
  /// Destinatario do convite.
  ///
  /// Preenchido = convite DIRECIONADO: a tela mostra o e-mail travado e a
  /// conta so pode nascer com ele. Vazio = convite ABERTO: quem abrir o link
  /// digita o proprio e-mail. O aberto e mais comodo para mandar por WhatsApp
  /// sem saber o endereco da pessoa; o direcionado e mais seguro, porque o
  /// link so serve para quem voce escolheu. Os dois continuam de uso unico.
  email          String?
  /// Organizacao de destino. Null = criar uma nova ao aceitar.
  organizationId String?
  /// Nome da empresa, usado quando o convite cria a organizacao.
  companyName    String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
}

/// Planilha enviada pelo cliente no chat.
///
/// Guardamos o CONTEUDO JA EXTRAIDO em texto, nunca o arquivo binario: e o
/// texto que a IA precisa ler, ele ocupa uma fracao do espaco, entra no backup
/// normalmente e nao exige volume nem storage externo.
model Upload {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  nomeArquivo    String
  /// Conteudo tabular em texto, ja truncado no limite de leitura.
  conteudo       String
  /// Quantas linhas o arquivo tinha antes de truncar (para avisar o usuario).
  totalLinhas    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

/// Alerta: avisa a organizacao quando algo muda.
///
/// Diferente do resumo diario, que sai no horario marcado sempre. O alerta
/// executa uma ferramenta periodicamente, compara com o resultado anterior e
/// so avisa QUANDO MUDOU — cliente novo inadimplente, boleto que venceu,
/// saldo que caiu.
///
/// A comparacao e feita em codigo, sem IA. A IA so entra para redigir o aviso
/// no momento em que ha algo a dizer: verificar com IA a cada 15 minutos
/// custaria mais que a mensalidade do cliente.
model Alert {
  id             String    @id @default(uuid())
  organizationId String
  /// O que o usuario pediu, com as palavras dele. Usado no aviso.
  descricao      String
  /// Ferramenta executada a cada verificacao (ex: asaas_cobrancas_vencidas).
  ferramenta     String
  /// Argumentos da ferramenta, quando ela precisar de algum.
  argumentos     Json?
  /// Intervalo minimo entre verificacoes.
  frequenciaMin  Int       @default(60)
  ativo          Boolean   @default(true)
  /// Resultado da ultima verificacao — a base da comparacao.
  ultimoResultado String?
  lastCheckedAt  DateTime?
  lastFiredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

/// Preferencia de resumo diario proativo de uma organizacao.
///
/// O Katalli envia o resumo sozinho no horario configurado, sem o dono
/// precisar perguntar — e o que transforma o produto de "ferramenta que
/// respondo quando lembro" em "assistente que trabalha".
model ReportSchedule {
  id             String    @id @default(uuid())
  organizationId String    @unique
  enabled        Boolean   @default(true)
  /// Por onde o resumo e entregue: "email" ou "whatsapp".
  /// Padrao e-mail: nao depende de aprovacao de plataforma nenhuma.
  channel        String    @default("email")
  /// Destino do e-mail. Vazio = e-mail da conta de acesso da organizacao.
  emailTo        String?
  /// Horario local (America/Sao_Paulo) em que o resumo deve sair.
  hour           Int       @default(8)
  minute         Int       @default(0)
  /// Instrucao opcional do dono sobre o que destacar no resumo.
  focus          String?
  /// Ultimo envio bem-sucedido — garante um envio por dia mesmo com restart.
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Uma mensagem trocada com um contato (historico de conversa persistente).
model Message {
  id             String   @id @default(uuid())
  contact        String // numero de WhatsApp do contato
  role           String // 'user' | 'assistant'
  content        String
  organizationId String? // escopo multi-tenant
  userId         String?
  createdAt      DateTime @default(now())

  @@index([contact, createdAt])
  @@index([organizationId, createdAt])
}

/// Consumo de tokens de UMA chamada a API da Anthropic.
///
/// Existe separado de OperationLog porque a granularidade e outra: o
/// OperationLog registra execucao de ferramenta, e um unico turno do usuario
/// gera varias chamadas a API (o loop de tool use) com zero ou muitas
/// ferramentas em cada uma.
///
/// Sem esta tabela nao ha como responder "quanto custa o cliente X por mes",
/// que e a pergunta que decide preco, limite de uso e se o roteamento de
/// modelo funcionou. Ate aqui o consumo so aparecia em logger.debug e era
/// descartado.
model AiUsage {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  /// Rota que originou a chamada (chat, alerta, instagram_dm, ...).
  rota           String
  /// Model ID efetivamente usado — o roteamento so e auditavel se registrado.
  modelo         String
  /// Posicao no loop de tool use (0 = primeira chamada do turno).
  rodada         Int      @default(0)
  /// Tokens de entrada cobrados integralmente (fora do prefixo cacheado).
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  /// Servidos do cache (~0,1x do preco de entrada).
  cacheReadTokens  Int    @default(0)
  /// Gravados no cache (~1,25x). Alto e constante significa cache invalidado.
  cacheWriteTokens Int    @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([modelo, createdAt])
}

/// Alguem que ja recebeu (ou recusou) contato de prospeccao.
///
/// POR QUE EXISTE: sem registro, prospeccao vira dano. O mesmo contato recebe
/// a mesma abordagem tres vezes, quem pediu para parar continua recebendo, e
/// nao ha como saber quantos e-mails sairam hoje — que e o numero que decide
/// se o dominio sobrevive.
///
/// A unicidade e do BANCO, nao de uma conferencia em codigo: duplicar contato
/// e o erro que mais custa reputacao, e checagem que depende de alguem lembrar
/// de chamar acaba esquecida.
model Prospecto {
  id             String    @id @default(uuid())
  organizationId String
  /// Sempre em minusculas — quem digita a planilha nao padroniza caixa, e
  /// "Joao@X.com" e "joao@x.com" sao a mesma pessoa recebendo duas vezes.
  email          String
  nome           String?
  empresa        String?
  /// De onde veio (nome da planilha, por exemplo). Serve para auditoria.
  origem         String?
  /// `contatado` | `respondeu` | `descadastrado`.
  ///
  /// `descadastrado` e definitivo: quem pediu para sair nao volta para a lista
  /// por uma importacao nova de planilha.
  status         String    @default("contatado")
  contatadoEm    DateTime  @default(now())
  observacao     String?

  @@unique([organizationId, email])
  @@index([organizationId, contatadoEm])
}

/// Uma medicao diaria de um numero do negocio do cliente.
///
/// POR QUE ESTA TABELA EXISTE: Instagram, HubSpot e Gmail so respondem sobre o
/// AGORA. O `getMetricas` do Instagram devolve um total do periodo, nao uma
/// serie; o HubSpot devolve o funil de hoje, nao o de mes passado. Nenhuma
/// dessas APIs deixa perguntar "como estava em julho".
///
/// Ou seja: historico so existe se NOS gravarmos. E o passado nao volta — o
/// grafico do cliente comeca no dia em que a coleta comecar, e nenhum codigo
/// futuro consegue preencher o que nao foi medido. E por isso que a coleta
/// entra antes da tela que a exibe.
///
/// Guardamos apenas AGREGADOS (seguidores, alcance, valor do funil). Nada de
/// linha a linha com nome de pessoa: numero agregado nao identifica ninguem, e
/// isso mantem a base fora do territorio de dado pessoal de terceiros.
model Metrica {
  id             String   @id @default(uuid())
  organizationId String
  /// Identificador da serie, no formato `fonte.metrica`.
  /// Ex: `instagram.seguidores`, `hubspot.funil.valor`.
  chave          String
  /// Valor medido. Float (double) basta: sao agregados de painel, longe dos
  /// 15 digitos significativos onde a precisao comecaria a doer.
  valor          Float
  /// Dia a que a medicao se refere — DATA, nao instante. O que interessa e
  /// "quanto era no dia 12", nao a hora em que o cron rodou.
  dia            DateTime @db.Date
  createdAt      DateTime @default(now())

  /// Uma medicao por serie por dia. E o que torna a coleta reexecutavel: um
  /// restart do processo, ou uma rodada manual para tapar buraco, atualiza a
  /// linha do dia em vez de criar um ponto duplicado no grafico.
  @@unique([organizationId, chave, dia])
  @@index([organizationId, chave, dia])
}

/// Um grafico salvo no painel de uma organizacao.
///
/// Existe porque planilha nao tem schema: a coluna que vira rotulo e a que vira
/// valor mudam de cliente para cliente. Alguem precisa decidir esse mapeamento,
/// e quem decide e a IA — UMA VEZ, na conversa em que o cliente pede o
/// grafico. O resultado dessa decisao mora aqui.
///
/// Por que salvar em vez de inferir toda vez: inferir a cada abertura do painel
/// custaria tokens em toda visita, deixaria a tela lenta e — pior — poderia
/// mudar de opiniao entre uma visita e outra, fazendo o grafico do cliente
/// mudar sozinho. Salvo, o painel renderiza em codigo puro, de graca e igual.
model PainelCard {
  id             String   @id @default(uuid())
  organizationId String
  /// Titulo exibido no card, com as palavras do proprio cliente.
  titulo         String
  /// De onde vem o dado: 'planilha_google' (unico hoje).
  fonte          String
  /// Como desenhar: 'barra' | 'linha' | 'numero'.
  tipo           String
  /// Mapeamento inferido pela IA. O formato depende de `fonte` e esta
  /// documentado em src/painel/painel.types.ts.
  ///
  /// As colunas sao guardadas por NOME, nunca por indice: o cliente insere uma
  /// coluna no meio da planilha sem avisar ninguem, e um indice guardado
  /// passaria a apontar para o dado errado em silencio — o grafico continuaria
  /// bonito, mostrando outra coisa. Nome que sumiu da planilha da erro visivel.
  config         Json
  /// Posicao na tela. Empate resolve por data de criacao.
  ordem          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, ordem])
}

/// Registro de cada execucao de ferramenta pela IA (auditoria/logs).
model OperationLog {
  id             String   @id @default(uuid())
  contact        String // contato que originou a operacao (se houver)
  tool           String // nome da ferramenta executada
  input          Json // argumentos recebidos
  result         String // resultado (texto devolvido a IA)
  success        Boolean  @default(true)
  organizationId String? // escopo multi-tenant
  userId         String?
  createdAt      DateTime @default(now())

  @@index([contact, createdAt])
  @@index([tool, createdAt])
  @@index([organizationId, createdAt])
}
