// Schema do banco de dados do Kyrius (Prisma + PostgreSQL).
// Fase 1 multi-tenant: organizacoes, usuarios, e escopo de conversas/logs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Uma empresa/cliente do Kyrius (tenant).
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  /// Instrucoes que o dono escreve para o atendimento AO PUBLICO (ex: Direct
  /// do Instagram): horario, endereco, servicos, precos, o que responder e o
  /// que nao responder. Vazio = o atendimento publico fica desligado.
  ///
  /// Fica aqui, e nao no system prompt, porque e conteudo de cada cliente —
  /// muda por organizacao e o proprio dono edita pela conversa.
  atendimentoInstrucoes String?

  /// Organizacao de DEMONSTRACAO: as ferramentas devolvem dados ficticios em
  /// vez de chamar as APIs reais.
  ///
  /// Serve para apresentar o produto sem expor dados de ninguem. O fluxo
  /// continua sendo o real — a IA escolhe a ferramenta, a execucao e auditada,
  /// escrita pede confirmacao — so a resposta da integracao e inventada.
  demo Boolean @default(false)

  users User[]
}

/// Um usuario, pertencente a uma organizacao. Identificado pelo WhatsApp.
model User {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String?
  /// Numero de WhatsApp. Opcional: quem entra so pelo Chat Web nao tem um.
  whatsappPhone  String?  @unique
  /// Login do Chat Web. Opcional: quem so usa WhatsApp nao tem e-mail cadastrado.
  email          String?  @unique
  /// Hash da senha do Chat Web (scrypt). Nunca guardar a senha em claro.
  passwordHash   String?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

/// Credenciais de uma integracao conectada por uma organizacao (multi-tenant).
/// DEV: credentials em texto. PRODUCAO: criptografar (ex: Secrets Manager).
model Connection {
  id             String   @id @default(uuid())
  organizationId String
  provider       String // 'hubspot' | 'stripe' | 'mercadopago' | 'asaas' | 'google'
  credentials    Json // ex: { "token": "..." }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, provider])
}

/// Convite de acesso ao Chat Web.
///
/// O cliente define a PROPRIA senha ao aceitar — assim ninguem precisa
/// manusear a credencial de outra pessoa. O token vai no link; no banco fica
/// apenas o hash, entao vazar a tabela nao entrega nenhum convite valido.
model Invite {
  id             String    @id @default(uuid())
  /// SHA-256 do token enviado no link.
  tokenHash      String    @unique
  email          String
  /// Organizacao de destino. Null = criar uma nova ao aceitar.
  organizationId String?
  /// Nome da empresa, usado quando o convite cria a organizacao.
  companyName    String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
}

/// Planilha enviada pelo cliente no chat.
///
/// Guardamos o CONTEUDO JA EXTRAIDO em texto, nunca o arquivo binario: e o
/// texto que a IA precisa ler, ele ocupa uma fracao do espaco, entra no backup
/// normalmente e nao exige volume nem storage externo.
model Upload {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  nomeArquivo    String
  /// Conteudo tabular em texto, ja truncado no limite de leitura.
  conteudo       String
  /// Quantas linhas o arquivo tinha antes de truncar (para avisar o usuario).
  totalLinhas    Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

/// Alerta: avisa a organizacao quando algo muda.
///
/// Diferente do resumo diario, que sai no horario marcado sempre. O alerta
/// executa uma ferramenta periodicamente, compara com o resultado anterior e
/// so avisa QUANDO MUDOU — cliente novo inadimplente, boleto que venceu,
/// saldo que caiu.
///
/// A comparacao e feita em codigo, sem IA. A IA so entra para redigir o aviso
/// no momento em que ha algo a dizer: verificar com IA a cada 15 minutos
/// custaria mais que a mensalidade do cliente.
model Alert {
  id             String    @id @default(uuid())
  organizationId String
  /// O que o usuario pediu, com as palavras dele. Usado no aviso.
  descricao      String
  /// Ferramenta executada a cada verificacao (ex: asaas_cobrancas_vencidas).
  ferramenta     String
  /// Argumentos da ferramenta, quando ela precisar de algum.
  argumentos     Json?
  /// Intervalo minimo entre verificacoes.
  frequenciaMin  Int       @default(60)
  ativo          Boolean   @default(true)
  /// Resultado da ultima verificacao — a base da comparacao.
  ultimoResultado String?
  lastCheckedAt  DateTime?
  lastFiredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

/// Preferencia de resumo diario proativo de uma organizacao.
///
/// O Kyrius envia o resumo sozinho no horario configurado, sem o dono
/// precisar perguntar — e o que transforma o produto de "ferramenta que
/// respondo quando lembro" em "assistente que trabalha".
model ReportSchedule {
  id             String    @id @default(uuid())
  organizationId String    @unique
  enabled        Boolean   @default(true)
  /// Por onde o resumo e entregue: "email" ou "whatsapp".
  /// Padrao e-mail: nao depende de aprovacao de plataforma nenhuma.
  channel        String    @default("email")
  /// Destino do e-mail. Vazio = e-mail da conta de acesso da organizacao.
  emailTo        String?
  /// Horario local (America/Sao_Paulo) em que o resumo deve sair.
  hour           Int       @default(8)
  minute         Int       @default(0)
  /// Instrucao opcional do dono sobre o que destacar no resumo.
  focus          String?
  /// Ultimo envio bem-sucedido — garante um envio por dia mesmo com restart.
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Uma mensagem trocada com um contato (historico de conversa persistente).
model Message {
  id             String   @id @default(uuid())
  contact        String // numero de WhatsApp do contato
  role           String // 'user' | 'assistant'
  content        String
  organizationId String? // escopo multi-tenant
  userId         String?
  createdAt      DateTime @default(now())

  @@index([contact, createdAt])
  @@index([organizationId, createdAt])
}

/// Registro de cada execucao de ferramenta pela IA (auditoria/logs).
model OperationLog {
  id             String   @id @default(uuid())
  contact        String // contato que originou a operacao (se houver)
  tool           String // nome da ferramenta executada
  input          Json // argumentos recebidos
  result         String // resultado (texto devolvido a IA)
  success        Boolean  @default(true)
  organizationId String? // escopo multi-tenant
  userId         String?
  createdAt      DateTime @default(now())

  @@index([contact, createdAt])
  @@index([tool, createdAt])
  @@index([organizationId, createdAt])
}
