# ==========================================================
# Nexa - Variaveis de ambiente (EXEMPLO)
# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NAO deve ser versionado (ja esta no .gitignore).
# ==========================================================

# Porta em que o backend vai rodar localmente
PORT=3000

# --- Banco de dados (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nexa?schema=public"

# --- WhatsApp Business Platform (Meta Cloud API) ---

# ID do numero de telefone (Phone Number ID) - visto no painel da Meta
WHATSAPP_PHONE_NUMBER_ID=1202341592967597

# Token de acesso da Meta.
# Em desenvolvimento: token temporario (24h) gerado no painel.
# Em producao: System User Token permanente.
WHATSAPP_ACCESS_TOKEN=cole_o_token_aqui

# Verify Token: uma senha que VOCE inventa. Sera usada no handshake
# do webhook (precisa ser a mesma coisa aqui e no painel da Meta).
WHATSAPP_VERIFY_TOKEN=nexa-verify-2026

# Versao da Graph API da Meta
WHATSAPP_API_VERSION=v21.0

# --- IA (Anthropic / Claude) ---
# Chave de API da Anthropic (https://console.anthropic.com/settings/keys).
# Aparece apenas uma vez ao criar; guarde com seguranca.
ANTHROPIC_API_KEY=sk-ant-...
# Modelo Claude a utilizar
ANTHROPIC_MODEL=claude-opus-4-8

# --- Integracao HubSpot (CRM) ---
# Token do Private App do HubSpot (comeca com pat-...).
HUBSPOT_ACCESS_TOKEN=pat-...

# --- Integracao Stripe (Pagamentos) ---
# Chave secreta de TESTE do Stripe (comeca com sk_test_...).
STRIPE_SECRET_KEY=sk_test_...

# --- Integracao Mercado Pago (Pagamentos BR) ---
# Access Token de TESTE do Mercado Pago (comeca com TEST-...).
MERCADOPAGO_ACCESS_TOKEN=TEST-...

# --- Integracao Asaas (Financeiro/Cobrancas BR) ---
# Chave de API do Asaas (comeca com $aact_...).
ASAAS_API_KEY=$aact_...
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# --- Integracao Google (Gmail + Google Agenda + Planilhas) ---
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=https://SEU-DOMINIO/google/callback
GOOGLE_REFRESH_TOKEN=

# --- Integracao Pagar.me (grupo Stone, pagamentos) ---
# Chave Secreta de TESTE do Pagar.me (comeca com sk_test_...).
PAGARME_SECRET_KEY=sk_test_...

# --- Integracao Pluggy (Open Finance / bancos) ---
PLUGGY_CLIENT_ID=...
PLUGGY_CLIENT_SECRET=...

# --- Integracao Instagram (metricas / API com Login do Facebook) ---
# Credenciais do MESMO app Meta usado pelo WhatsApp
# (Configuracoes do app > Basico, no painel de desenvolvedores).
META_APP_ID=...
META_APP_SECRET=...
INSTAGRAM_REDIRECT_URI=https://SEU-DOMINIO/instagram/callback
# Versao da Graph API usada pelo Instagram (opcional; padrao v23.0)
INSTAGRAM_API_VERSION=v23.0
# Token global de fallback (opcional). O fluxo normal e conectar por
# organizacao em /instagram/auth?org=<id>, que guarda o token da Pagina.
INSTAGRAM_ACCESS_TOKEN=

# --- Producao (docker-compose.prod.yml) ---
# Usadas apenas no servidor. Em desenvolvimento o DATABASE_URL acima ja basta.
#
# ⚠️ Em producao, o DATABASE_URL precisa apontar para o HOST DO SERVICO, nao
# para localhost: dentro da rede do compose o banco atende em "postgres".
#   DATABASE_URL="postgresql://kyrius:SUA_SENHA@postgres:5432/kyrius?schema=public"
#
# O compose NAO monta essa URL sozinho (ver comentario no topo do
# docker-compose.prod.yml) — escreva o valor completo aqui.
POSTGRES_USER=kyrius
POSTGRES_PASSWORD=
POSTGRES_DB=kyrius
# Nome do container do Postgres, usado por `npm run banco:backup`.
# Em dev o container se chama nexa-postgres; no compose de producao, "postgres".
POSTGRES_CONTAINER=nexa-postgres

# --- Chat Web (autenticacao) ---
# Senha de acesso ao /chat. SEM ELA O CHAT FICA BLOQUEADO (fail-closed):
# o endpoint era publico e qualquer pessoa com a URL consumia credito da IA.
CHAT_ACCESS_PASSWORD=

# Segredo usado para assinar os tokens de sessao do chat. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se ficar vazio, o servidor usa um segredo volatil e todas as sessoes caem
# a cada reinicio (funciona, mas incomoda).
CHAT_SESSION_SECRET=

# --- Criptografia das credenciais ---
# Chave AES-256 (64 caracteres hex) usada para cifrar Connection.credentials
# no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# GUARDE COM CUIDADO: sem esta chave as credenciais ja gravadas sao
# IRRECUPERAVEIS. Nao versione, e faca backup separado do banco.
# Sem ela a aplicacao se recusa a salvar novas credenciais (fail-closed).
CONNECTION_ENCRYPTION_KEY=

# --- Seguranca multi-tenant ---
# Organizacao dona desta instalacao: a UNICA autorizada a usar as credenciais
# globais acima como fallback quando nao tem conexao propria.
#
# Todo contato novo (WhatsApp ou chat web) vira uma organizacao automaticamente.
# Sem esta variavel o fallback fica DESATIVADO para todos — cada organizacao
# precisa conectar as proprias contas. Nunca deixe em branco esperando que o
# fallback continue valendo "para todo mundo": era assim que um desconhecido
# herdava o Gmail, o Drive e o financeiro do dono.
#
# Descubra o id com:
#   docker exec nexa-postgres psql -U nexa -d nexa \
#     -c 'SELECT id, name FROM "Organization";'
OWNER_ORGANIZATION_ID=
